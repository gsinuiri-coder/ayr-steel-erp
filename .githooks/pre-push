#!/bin/sh

if [ "${AYR_OWNER_PUSH:-}" = "1" ]; then
  exit 0
fi

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    cat >&2 <<'EOF'
AYR Steel ERP: push a main bloqueado para agentes.
Presenta el resumen de D-232 y espera el OK explícito del dueño; después repite con AYR_OWNER_PUSH=1.
EOF
    exit 1
  fi
done

exit 0
