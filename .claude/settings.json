{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(grep *)",
      "Bash(sed -n *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(gh repo sync*)",
      "Read(**/.env*)",
      "Bash(grep *.env*)",
      "Bash(sed *.env*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(gcloud run deploy *)",
      "Bash(gcloud run services update *)",
      "Bash(gcloud run services replace *)",
      "Bash(pnpm deploy:api*)",
      "Bash(pnpm deploy:web*)",
      "Bash(vercel *)",
      "Bash(neonctl *)",
      "Bash(pnpm db:prod*)",
      "Bash(pnpm prod:*)",
      "Bash(pnpm normalize:coil-skus*)",
      "Bash(pnpm sweep:imported*)",
      "Bash(node scripts/db-reset-dev.mjs*)",
      "Bash(pnpm import:initial-inventory*)",
      "Bash(node scripts/db-prod.mjs*)",
      "Bash(node scripts/production-cleanup-v4.mjs*)",
      "Bash(node scripts/prod-reset-go-live.mjs*)",
      "Bash(node scripts/prod-e2e-purge.mjs*)",
      "Bash(node scripts/prod-e2e-leftovers.mjs*)",
      "Bash(git branch -D *)",
      "Bash(rm -rf *)"
    ]
  }
}
