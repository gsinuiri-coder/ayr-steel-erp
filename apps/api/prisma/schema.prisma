// Schema v0 (Fase 0): identidad, sesiones y auditoría.
// Fase 1 (D-034): maestros — líneas de negocio, acabados, catálogo, clientes,
// proveedores, márgenes, tipo de cambio, e importación masiva genérica.
// Fase 2a (D-041): kardex append-only (`inventory_movements`/`inventory_balances`),
// compras con recepción y pagos parciales, y alta de bobinas por tres vías.
// Fase 2b (D-041): reversa de movimientos, partido de bobina (`coil_splits`), merma,
// cierre/edición/anulación de bobina, anulación de compra recibida y landed cost
// (`purchases.related_purchase_id`, D-043).
// Fase 3 (D-047..D-050): corte tercerizado (`cutting_orders`/`cutting_order_coils`,
// RF-40..42), flejes como `coils.kind = STRIP` (D-049), envío sin movimiento de kardex
// (`CoilStatus.IN_THIRD_PARTY`, D-050) y prorrateo del costo del servicio de corte
// (`purchases.related_cutting_order_id`).
// Fase 4 (D-055..D-060): producción de drywall — receta en el maestro de productos
// (`product_boms`), orden de producción (`production_orders`) con flejes asignados
// (`production_order_consumptions`, sin kardex al asignar) y reportes parciales de
// piezas (`production_reports`, kardex por reporte); merma de proceso y costeo al cerrar.
// Fase 5a (D-064..D-069): ciclo comercial hasta la reserva — cotización (`quotations`),
// pedido (`sales_orders`) y ledger de reservas (`reservations`, fuera del kardex por
// D-054), más `products.list_price_pen` (precio de lista, D-068) y
// `business_lines.quotation_required` (D-065). Todo en soles (D-064).
// Fase 6 (D-082..D-091): producción de coberturas metálicas contra pedido — maestro de
// colores (`colors`, D-085), receta y orden de producción con `kind` (D-087), plan de
// corte y largos reportados (`production_order_items`, `production_report_pieces`),
// subítems de largo en la línea comercial (`quotation_item_pieces`,
// `sales_order_item_pieces`, D-083) y la reserva que se traslada del insumo al producto
// terminado (D-088: `reservations` deja de ser única por línea de pedido).
// Fase 5b (D-070..D-078): ciclo fiscal y logístico sobre el pedido — documentos
// electrónicos (`fiscal_documents`: factura, boleta, nota de crédito y guía de remisión
// remitente, todos con la misma máquina de estados y el mismo job de reintento),
// series con correlativo asignado al enviar (`fiscal_series`, D-072), despacho que mueve
// kardex y cierra el pedido (`dispatches`, D-074), cobranza espejo de los pagos a
// proveedor (`customer_payments`, D-075) y la configuración de contingencia
// (`invoicing_settings`, D-073).
// Regla D-003: dinero/kg/mm/tasas son siempre `Decimal @db.Decimal(p, s)` con
// escala explícita (dinero 4, kg 3, mm 2, tasas/factores 4). Nunca `number`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Roles del sistema (RF-02). Espejo de `Role` en @ayr/shared.
enum Role {
  ADMINISTRADOR
  SUPERVISOR_PLANTA
  VENDEDOR
}

/// Identificador de línea de negocio (§2.2). Espejo de `BusinessLine` en @ayr/shared.
/// Se declara en v0 para que el enum exista desde la primera migración; en Fase 1
/// pasa a ser el `code` único de la tabla `business_lines` (modelo `BusinessLine`).
enum BusinessLineCode {
  DRYWALL          @map("drywall")
  METALLIC_ROOFING @map("metallic-roofing")
  ROOFING          @map("roofing")
  TRADING          @map("trading")
  SERVICES         @map("services")
}

/// Estrategia de inventario de una línea de negocio (§2.2). `services` es `NOOP`.
enum InventoryStrategy {
  STOCK
  NOOP
}

/// Moneda de compras y ventas (D-029/P-06).
enum Currency {
  PEN
  USD
}

/// Origen del tipo de cambio cacheado en `exchange_rates` (D-029).
enum ExchangeRateSource {
  API
  MANUAL
}

/// Origen de un producto del catálogo (§4.5).
enum ProductSource {
  MANUFACTURED
  PURCHASED
}

/// Tipo de documento de identidad/tributario de un cliente o proveedor (RF-80/RF-81).
enum DocType {
  DNI
  RUC
  CE
}

/// Entidad destino de un lote de importación masiva (RF-52, base de RF-12/RF-71).
enum ImportEntity {
  PRODUCTS
  CUSTOMERS
  COILS
  /// RF-71: comprobantes ya emitidos afuera. Una fila por **línea**, agrupadas por número.
  FISCAL_DOCUMENTS
}

/// Qué clase de ítem mueve el kardex (§3.2). Un producto de catálogo o una bobina.
enum InventoryItemType {
  PRODUCT
  COIL
}

/// Sentido del movimiento de kardex (§3.3). `ADJUST` corrige el **costo** sin mover la
/// cantidad (landed cost, D-043): su `qty` son los kilos afectados y su `unitCost` el
/// delta por kilo. Anular siempre es un movimiento inverso, nunca un DELETE.
enum InventoryMovementType {
  IN
  OUT
  ADJUST
}

/// Qué originó el movimiento de kardex. Los valores que Fase 2a no emite todavía
/// quedan reservados para no migrar el enum en cada fase siguiente.
enum InventoryRefType {
  PURCHASE
  SALE
  PRODUCTION
  /// Partido de bobina (RF-15, Fase 2b).
  SPLIT
  /// Merma (RF-17, D-040, Fase 2b). "SCRAP" por §0.1; la UI lo llama merma.
  SCRAP
  /// Corte tercerizado (RF-40/41, Fase 3).
  CUTTING
  /// Ajuste manual de inventario.
  ADJUSTMENT
  /// Carga inicial por importación de planilla (RF-12).
  IMPORT
}

/// Tipo de compra (D-030). Determina qué formulario se usa y qué pasa al recibirla.
enum PurchaseType {
  COIL
  FINISHED_GOOD
  SERVICE
  EXPENSE
}

/// Comprobante de compra según el catálogo 01 de SUNAT (D-030).
enum PurchaseDocType {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
}

/// Condición de pago de una compra (D-039).
enum PaymentTerms {
  CONTADO
  CREDITO
}

/// Estado de una compra (D-030). `RECEIVED` es la que ya movió kardex.
enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

/// Naturaleza de una compra de servicio (D-030, RF-41). `FREIGHT`, `CUSTOMS` e
/// `INSURANCE` son los que se pueden imputar al costo de una compra de bobinas
/// (landed cost, D-043); `CUTTING` prorratea distinto y es de Fase 3.
enum ServiceKind {
  CUTTING
  FREIGHT
  CUSTOMS
  INSURANCE
  OTHER
}

/// Medio de pago a proveedor (D-039).
enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  DEPOSIT
  /// Tarjeta de débito o crédito por POS bancario (Fase 7b, D-101).
  CARD
  /// Billetera móvil: Yape, Plin y equivalentes (Fase 7b, D-101).
  WALLET
  OTHER
}

/// Estado de una bobina (RF-19). `CLOSED` no entra a producción; `CANCELLED` solo
/// es alcanzable si no tuvo movimientos aparte del ingreso inicial (RF-21).
/// `IN_THIRD_PARTY` (D-050, Fase 3): la bobina está en poder de un proveedor de corte;
/// sigue siendo del kardex de la empresa pero no entra a producción ni a partido local.
enum CoilStatus {
  OPEN
  CLOSED
  CANCELLED
  IN_THIRD_PARTY
}

/// Clase de fila de `coils` (D-049). Un fleje es una bobina `STRIP`, hija de la madre
/// (`parentCoilId`) que la originó, comprada o enviada a corte tercerizado.
enum CoilKind {
  COIL
  STRIP
}

/// Estado de una orden de corte tercerizado (RF-40..42, D-049/D-050).
/// `PARTIALLY_RECEIVED` cuando algunas bobinas de la orden ya volvieron y otras siguen
/// en el tercero; `RECEIVED` cuando ya no queda ninguna `SENT` (recibida o cancelada).
enum CuttingOrderStatus {
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Estado de una bobina dentro de una orden de corte (RF-40..42).
enum CuttingOrderCoilStatus {
  SENT
  RECEIVED
  CANCELLED
}

/// Estado de un partido de bobina (RF-15/RF-16). Revertir no borra la fila: la marca
/// `REVERTED` y emite las reversas de kardex, igual que el resto de anulaciones.
enum CoilSplitStatus {
  ACTIVE
  REVERTED
}

/// Qué línea de transformación fabrica una orden (D-087). `DRYWALL` consume flejes contra
/// una receta de largo fijo y reporta piezas; `ROOFING` consume bobina, reporta largos
/// reales contra el plan copiado del pedido (D-084) y lleva el producto terminado a medida
/// en metros lineales (D-083). Comparten tabla, correlativo, estados y auditoría; lo que no
/// comparten es el servicio que las opera.
enum ProductionOrderKind {
  DRYWALL
  ROOFING
}

/// Qué clase de receta es (D-087). `DRYWALL` usa ancho de fleje, largo de pieza y kilo por
/// pieza; `ROOFING` solo necesita acabado y espesor de entrada, porque el largo lo pone el
/// pedido y el kilo teórico sale de la bobina que se monta (D-047).
enum ProductBomKind {
  DRYWALL
  ROOFING
}

/// Estado de una orden de producción (RF-34, Fase 4, D-058). La UI los llama
/// BORRADOR / EN PROCESO / CERRADA / ANULADA (§0.1: identificadores en inglés).
/// `DRAFT` es la OP recién creada, sin ningún fleje asignado todavía; `IN_PROGRESS`
/// desde que se le asigna el primero. `CLOSED` y `CANCELLED` son terminales.
enum ProductionOrderStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
  CANCELLED
}

/// Estado de un reporte de piezas dentro de una OP (D-060). Revertir no borra la fila:
/// la marca `REVERTED` y emite las reversas de kardex, igual que `CoilSplitStatus`.
enum ProductionReportStatus {
  ACTIVE
  REVERTED
}

/// Estado de una cotización (D-069). La UI los llama BORRADOR / EMITIDA / CONFIRMADA /
/// VENCIDA / ANULADA (§0.1: identificadores en inglés). `EXPIRED` lo pone el job diario
/// al pasar `validUntil`; anular el pedido devuelve la cotización a `EMITTED` si sigue vigente.
enum QuotationStatus {
  DRAFT
  EMITTED
  CONFIRMED
  EXPIRED
  CANCELLED
}

/// Estado de un pedido (D-065). Estados mínimos de Fase 5a: despacho, guía y cobranza
/// son de Fase 5b.
enum SalesOrderStatus {
  CONFIRMED
  IN_PRODUCTION
  /// D-074: hay mercadería despachada y todavía queda pendiente en alguna línea.
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

/// Estado de una reserva de stock (D-054, D-066). `ACTIVE` es la única que descuenta
/// disponible y la única que bloquea operaciones sobre el ítem.
enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

/// Tipo de documento electrónico que **emitimos** (catálogo 01 de SUNAT, D-072). El de
/// compras es `PurchaseDocType` y no se mezcla: aquel describe lo que nos emitieron a
/// nosotros y admite nota de débito, que acá está diferida.
///
/// `GUIA_REMISION_REMITENTE` comparte tabla con los comprobantes de pago a propósito
/// (D-071/D-073): es otro documento electrónico con la misma máquina de estados, el mismo
/// job de reintento y el mismo layout de archivos en R2. Un `CHECK` en `fiscal_documents`
/// impide que un comprobante nazca con ese tipo por accidente.
enum FiscalDocType {
  /// Catálogo 01, código 01.
  FACTURA
  /// Catálogo 01, código 03.
  BOLETA
  /// Catálogo 01, código 07.
  NOTA_CREDITO
  /// Catálogo 01, código 09.
  GUIA_REMISION_REMITENTE
}

/// Máquina de estados de un documento electrónico (D-073). La UI los llama BORRADOR /
/// EMITIDO / ACEPTADO / RECHAZADO / ERROR DE ENVÍO / BAJA EN TRÁMITE / ANULADO.
///
/// `ISSUED` es el estado de contingencia y el corazón de D-073: el correlativo ya está
/// tomado, el documento existe para la empresa y **habilita el despacho**, pero el PSE
/// todavía no lo aceptó. `SEND_ERROR` es lo mismo con un intento fallido encima; los dos
/// los reintenta el job. `REJECTED` es terminal: se corrige y se **reemite con un
/// correlativo nuevo** (D-072), y el rechazado queda en el historial.
enum FiscalDocumentStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  SEND_ERROR
  VOID_PENDING
  VOIDED
}

/// De dónde salió el documento (RF-71, D-105). `ISSUED_HERE` tomó correlativo de una serie
/// propia y pasó por el puerto del PSE; `IMPORTED` ya existía emitido afuera —histórico o
/// contingencia en el portal de SUNAT— y entró por planilla. Un importado no se envía, no
/// se anula contra el PSE desde acá, y es el único reimportable (RF-72).
enum FiscalDocumentOrigin {
  ISSUED_HERE
  IMPORTED
}

/// Motivo de una nota de crédito (catálogo 09 de SUNAT). Solo los que el negocio usa;
/// el resto del catálogo entra cuando haga falta, sin migrar lo emitido.
enum CreditNoteReason {
  /// 01 — anulación de la operación.
  ANULACION_OPERACION
  /// 02 — anulación por error en el RUC.
  ANULACION_ERROR_RUC
  /// 03 — corrección por error en la descripción.
  CORRECCION_DESCRIPCION
  /// 04 — descuento global.
  DESCUENTO_GLOBAL
  /// 05 — descuento por ítem.
  DESCUENTO_ITEM
  /// 06 — devolución total.
  DEVOLUCION_TOTAL
  /// 07 — devolución por ítem.
  DEVOLUCION_ITEM
  /// 13 — ajuste de operaciones de exportación (y otros ajustes de monto).
  OTROS_AJUSTES
}

/// Modalidad de traslado de un despacho (catálogo 18 de SUNAT, D-078). Se elige **por
/// despacho**, no en configuración: la decide el envío concreto.
enum TransferMode {
  PRIVATE
  PUBLIC
  /// Recojo en mostrador (Fase 7b, D-103): se lo lleva el comprador. Sin vehículo, sin
  /// transportista y sin guía de remisión remitente — el traslado no es nuestro.
  PICKUP
}

/// Estado de un despacho (D-074). Mismo criterio que `CoilSplitStatus` y
/// `ProductionReportStatus`: revertir no borra la fila, la marca.
enum DispatchStatus {
  ISSUED
  REVERSED
}

/// Estado de una fila dentro de un lote de importación.
enum ImportRowStatus {
  VALID
  INVALID
  CONFIRMED
}

/// Estado de un lote de importación completo.
enum ImportBatchStatus {
  PARSED
  CONFIRMED
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  email              String        @unique @db.VarChar(160)
  name               String        @db.VarChar(120)
  passwordHash       String        @map("password_hash")
  role               Role
  active             Boolean       @default(true)
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  /// Turnos de caja del punto de venta (Fase 7b, D-101).
  cashSessions       CashSession[] @relation("CashSessionUser")

  @@map("users")
}

/// Sesiones con refresh token (D-010). Revocar = `revokedAt` no nulo.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.VarChar(128)
  /// Hash anterior: se acepta unos segundos tras rotar para tolerar refresh concurrentes (dos pestañas).
  previousTokenHash String?   @unique @map("previous_token_hash") @db.VarChar(128)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ip                String?   @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Auditoría append-only (§3.3, RF-95). Nunca se actualiza ni se borra.
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  actorId  String?  @map("actor_id") @db.Uuid
  action   String   @db.VarChar(80)
  entity   String   @db.VarChar(80)
  entityId String?  @map("entity_id") @db.VarChar(80)
  before   Json?
  after    Json?
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId, at])
  @@map("audit_log")
}

/// Líneas de negocio (§2.2). Fila sembrada por la migración; el módulo API solo
/// las lee (no hay alta/baja de líneas de negocio, `code` es un dominio fijo).
model BusinessLine {
  id                String            @id @default(uuid()) @db.Uuid
  code              BusinessLineCode  @unique
  name              String            @db.VarChar(80)
  inventoryStrategy InventoryStrategy @map("inventory_strategy")
  /// D-065: la línea exige cotización confirmada antes de vender (RF-31, coberturas) o
  /// admite pedido directo (perfiles, trading). Es el flag que decide si `POST
  /// /sales/orders` se acepta o se rechaza para un producto de esta línea.
  quotationRequired Boolean           @default(false) @map("quotation_required")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  products           Product[]
  pricingSettings    PricingSetting?
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
  purchases          Purchase[]
  coils              Coil[]
  cuttingOrders      CuttingOrder[]
  productionOrders   ProductionOrder[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]

  @@map("business_lines")
}

/// Acabados de bobina (RF-25), con su factor de densidad (Decimal 10,4).
model Finish {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(20)
  name          String   @db.VarChar(120)
  densityFactor Decimal  @map("density_factor") @db.Decimal(10, 4)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  coils         Coil[]
  purchaseItems PurchaseItem[]
  boms          ProductBom[]

  @@map("finishes")
}

/// Catálogo de productos por línea (RF-50). El SKU es único dentro de su línea,
/// no globalmente (dos líneas pueden reusar el mismo código de SKU).
model Product {
  id             String        @id @default(uuid()) @db.Uuid
  businessLineId String        @map("business_line_id") @db.Uuid
  businessLine   BusinessLine  @relation(fields: [businessLineId], references: [id])
  sku            String        @db.VarChar(40)
  name           String        @db.VarChar(160)
  unit           String        @db.VarChar(20)
  source         ProductSource
  /// D-068: precio de lista de venta, **sin IGV y en soles** (D-064). Único por producto
  /// en v1; las listas por cliente o por volumen quedan diferidas y entran, si hacen
  /// falta, como una tabla aparte que sobreescriba este valor.
  listPricePen   Decimal?      @map("list_price_pen") @db.Decimal(18, 4)
  /// D-085: color del producto. Solo lo llevan las coberturas prepintadas; el resto del
  /// catálogo va en null. El SKU lo refleja para leerlo a simple vista (espíritu de D-037),
  /// pero **todo filtrado y todo emparejamiento con la bobina es por este id**, nunca
  /// parseando el SKU.
  colorId        String?       @map("color_id") @db.Uuid
  color          Color?        @relation(fields: [colorId], references: [id])
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseItems    PurchaseItem[]
  /// Receta de fabricación (D-059). Solo la tienen los productos fabricados.
  bom              ProductBom?
  productionOrders ProductionOrder[]
  quotationItems   QuotationItem[]
  salesOrderItems  SalesOrderItem[]
  invoiceItems     FiscalDocumentItem[]
  dispatchItems    DispatchItem[]

  @@unique([businessLineId, sku])
  @@index([businessLineId])
  @@index([colorId])
  @@map("products")
}

/// Clientes (RF-80, RF-82). Baja lógica: `isActive`, nunca `DELETE`.
model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  docType    DocType  @map("doc_type")
  docNumber  String   @map("doc_number") @db.VarChar(20)
  name       String   @db.VarChar(160)
  address    String?  @db.VarChar(240)
  email      String?  @db.VarChar(160)
  phone      String?  @db.VarChar(30)
  creditDays Int      @default(0) @map("credit_days")
  /// D-077: cliente sembrado por el sistema ("PÚBLICO EN GENERAL"). No se edita ni se
  /// da de baja desde ninguna ruta; existe para que la boleta sin cliente identificado
  /// sea una venta normal y no un caso especial en todo el ciclo.
  isSystem   Boolean  @default(false) @map("is_system")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotations      Quotation[]
  salesOrders     SalesOrder[]
  fiscalDocuments FiscalDocument[]

  @@unique([docType, docNumber])
  @@map("customers")
}

/// Proveedores (RF-81, RF-83). `providesCuttingService` habilita el corte
/// tercerizado (D-033/P-10); el costo por kg se ingresa al recibir, no aquí.
/// `code` (3-6 letras, único) es el primer segmento del código de bobina (RF-13);
/// `coilSeq` es el correlativo por proveedor de ese mismo código, incrementado de
/// forma atómica (`UPDATE ... RETURNING`) para que dos altas concurrentes no colisionen.
model Supplier {
  id                     String   @id @default(uuid()) @db.Uuid
  code                   String   @unique @db.VarChar(6)
  docType                DocType  @map("doc_type")
  docNumber              String   @map("doc_number") @db.VarChar(20)
  name                   String   @db.VarChar(160)
  address                String?  @db.VarChar(240)
  email                  String?  @db.VarChar(160)
  phone                  String?  @db.VarChar(30)
  creditDays             Int      @default(0) @map("credit_days")
  providesCuttingService Boolean  @default(false) @map("provides_cutting_service")
  coilSeq                Int      @default(0) @map("coil_seq")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchases     Purchase[]
  coils         Coil[]
  cuttingOrders CuttingOrder[]

  @@unique([docType, docNumber])
  @@map("suppliers")
}

/// Márgenes por línea de negocio (D-032/P-09). `marginPct`/`minMarginPct` son
/// puntos porcentuales (15.5000 = 15.5%). Solo ADMINISTRADOR los edita.
/// `overheadPerKg` (D-035/P-11) es el gasto indirecto de fábrica por kilo producido
/// que se suma al costo de producción; en dinero de la línea, escala 4.
model PricingSetting {
  id             String       @id @default(uuid()) @db.Uuid
  businessLineId String       @unique @map("business_line_id") @db.Uuid
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  marginPct      Decimal      @map("margin_pct") @db.Decimal(7, 4)
  minMarginPct   Decimal      @map("min_margin_pct") @db.Decimal(7, 4)
  overheadPerKg  Decimal      @default(0) @map("overhead_per_kg") @db.Decimal(18, 4)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pricing_settings")
}

/// Tipo de cambio del día (D-029/P-06): caché de apis.net.pe o registro manual
/// cuando la API externa no responde (`source = MANUAL`).
model ExchangeRate {
  id        String             @id @default(uuid()) @db.Uuid
  date      DateTime           @db.Date
  currency  Currency
  buy       Decimal            @db.Decimal(10, 4)
  sell      Decimal            @db.Decimal(10, 4)
  source    ExchangeRateSource
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([date, currency])
  @@map("exchange_rates")
}

/// Lote de importación masiva desde planilla (RF-52; base de RF-12/RF-71).
/// El archivo original vive en R2 (`fileKey`); las filas parseadas en `ImportRow`.
model ImportBatch {
  id          String            @id @default(uuid()) @db.Uuid
  entity      ImportEntity
  fileKey     String            @map("file_key") @db.VarChar(300)
  fileName    String            @map("file_name") @db.VarChar(200)
  status      ImportBatchStatus @default(PARSED)
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  rows ImportRow[]

  @@map("import_batches")
}

/// Una fila de un lote de importación, con sus errores de validación (si los
/// tiene) y, tras confirmar, el id de la entidad que creó.
model ImportRow {
  id              String          @id @default(uuid()) @db.Uuid
  batchId         String          @map("batch_id") @db.Uuid
  batch           ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber       Int             @map("row_number")
  data            Json
  errors          Json?
  /// RF-72: lo que hay que ver antes de confirmar y **no** bloquea (que esta fila archiva
  /// la versión anterior de un comprobante). Lo que está en `errors` no se confirma.
  warnings        Json?
  status          ImportRowStatus @default(VALID)
  createdEntityId String?         @map("created_entity_id") @db.Uuid

  @@index([batchId])
  @@map("import_rows")
}

// ---------------------------------------------------------------------------
// Fase 2a — Kardex (§3.2, D-028), compras (D-030) y bobinas (RF-10..RF-14)
// ---------------------------------------------------------------------------

/// Kardex append-only (§3.2, §3.3). NUNCA se actualiza ni se borra una fila: anular
/// es emitir el movimiento inverso apuntando al original con `reversalOfId`.
/// El único escritor es `InventoryService.record`; ningún módulo inserta aquí directo.
model InventoryMovement {
  id             BigInt                @id @default(autoincrement())
  businessLineId String                @map("business_line_id") @db.Uuid
  businessLine   BusinessLine          @relation(fields: [businessLineId], references: [id])
  itemType       InventoryItemType     @map("item_type")
  itemId         String                @map("item_id") @db.Uuid
  type           InventoryMovementType
  /// Siempre positiva: el sentido lo da `type`. Escala kg (3) sirve también para unidades.
  qty            Decimal               @db.Decimal(16, 3)
  /// Unidad SUNAT catálogo 03 (KGM, NIU...). Ver `docs/referencias/ubl21-factura.md`.
  unit           String                @db.VarChar(20)
  unitCost       Decimal               @map("unit_cost") @db.Decimal(18, 4)
  totalCost      Decimal               @map("total_cost") @db.Decimal(18, 4)
  refType        InventoryRefType      @map("ref_type")
  refId          String?               @map("ref_id") @db.VarChar(80)
  /// Motivo escrito por el usuario: merma (RF-17), anulación (RF-18, RF-21) o ajuste
  /// de costo (D-043). El kardex lo muestra tal cual; no participa de ningún cálculo.
  notes          String?               @db.VarChar(240)
  reversalOfId   BigInt?               @map("reversal_of_id")
  reversalOf     InventoryMovement?    @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversals      InventoryMovement[]   @relation("MovementReversal")
  actorId        String?               @map("actor_id") @db.Uuid
  at             DateTime              @default(now()) @db.Timestamptz(3)

  /// Un movimiento se anula una sola vez (Postgres permite varios NULL en un índice único).
  @@unique([reversalOfId])
  @@index([itemType, itemId, at])
  @@index([businessLineId, at])
  @@index([refType, refId])
  @@map("inventory_movements")
}

/// Saldo vigente por ítem, con costo promedio ponderado (D-028). Se actualiza en la
/// misma transacción que el movimiento que lo causa; es un caché derivado del kardex,
/// nunca la fuente de verdad.
model InventoryBalance {
  id             String            @id @default(uuid()) @db.Uuid
  businessLineId String            @map("business_line_id") @db.Uuid
  businessLine   BusinessLine      @relation(fields: [businessLineId], references: [id])
  itemType       InventoryItemType @map("item_type")
  itemId         String            @map("item_id") @db.Uuid
  qty            Decimal           @db.Decimal(16, 3)
  avgCost        Decimal           @map("avg_cost") @db.Decimal(18, 4)
  unit           String            @db.VarChar(20)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([itemType, itemId])
  @@index([businessLineId])
  @@map("inventory_balances")
}

/// Compra a proveedor (D-030). `subtotal`/`igv`/`total` en la moneda del documento;
/// `totalPen` es el equivalente en soles con el TC guardado (D-029). El costo que
/// entra al kardex es el subtotal, sin IGV (D-038).
model Purchase {
  id                    String             @id @default(uuid()) @db.Uuid
  supplierId            String             @map("supplier_id") @db.Uuid
  supplier              Supplier           @relation(fields: [supplierId], references: [id])
  businessLineId        String             @map("business_line_id") @db.Uuid
  businessLine          BusinessLine       @relation(fields: [businessLineId], references: [id])
  type                  PurchaseType
  docType               PurchaseDocType    @map("doc_type")
  series                String             @db.VarChar(10)
  number                String             @db.VarChar(20)
  issueDate             DateTime           @map("issue_date") @db.Date
  currency              Currency
  exchangeRate          Decimal            @map("exchange_rate") @db.Decimal(10, 4)
  exchangeRateSource    ExchangeRateSource @map("exchange_rate_source")
  subtotal              Decimal            @db.Decimal(18, 4)
  igv                   Decimal            @db.Decimal(18, 4)
  total                 Decimal            @db.Decimal(18, 4)
  totalPen              Decimal            @map("total_pen") @db.Decimal(18, 4)
  paymentTerms          PaymentTerms       @map("payment_terms")
  creditDays            Int?               @map("credit_days")
  dueDate               DateTime?          @map("due_date") @db.Date
  status                PurchaseStatus     @default(DRAFT)
  /// Solo en compras de tipo SERVICE (D-030): decide si el servicio se puede imputar
  /// al costo de una compra de bobinas (D-043) o al de un corte tercerizado (Fase 3).
  serviceKind           ServiceKind?       @map("service_kind")
  /// Landed cost (D-043): compra `COIL` a la que se imputa esta compra de servicio.
  /// Solo con `serviceKind` FREIGHT/CUSTOMS/INSURANCE. Se prorratea al recibirla.
  relatedPurchaseId     String?            @map("related_purchase_id") @db.Uuid
  relatedPurchase       Purchase?          @relation("LandedCost", fields: [relatedPurchaseId], references: [id])
  landedCostServices    Purchase[]         @relation("LandedCost")
  /// Costo de corte tercerizado (RF-41): orden de corte a la que se imputa esta compra
  /// de servicio. Solo con `serviceKind = CUTTING`. Se prorratea por kg entre los flejes
  /// recibidos de esa orden al recibirla (D-049), sin importar si llega antes o después
  /// de la recepción física.
  relatedCuttingOrderId String?            @map("related_cutting_order_id") @db.Uuid
  relatedCuttingOrder   CuttingOrder?      @relation(fields: [relatedCuttingOrderId], references: [id])
  /// Key en R2 del XML de la factura del proveedor cuando la compra nació de RF-11.
  sourceXmlKey          String?            @map("source_xml_key") @db.VarChar(300)
  notes                 String?            @db.VarChar(500)
  createdById           String             @map("created_by_id") @db.Uuid
  receivedAt            DateTime?          @map("received_at") @db.Timestamptz(3)
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  items    PurchaseItem[]
  payments SupplierPayment[]
  coils    Coil[]

  /// Un mismo comprobante no se registra dos veces para el mismo proveedor.
  @@unique([supplierId, docType, series, number])
  @@index([businessLineId, issueDate])
  @@index([supplierId, status])
  @@index([relatedPurchaseId])
  @@index([relatedCuttingOrderId])
  @@map("purchases")
}

/// Línea de una compra. En compras COIL cada línea es una bobina y usa los campos
/// `finishId`/`widthMm`/`thicknessMm` (`qty` son los kilos, `unitPrice` el precio/kg
/// sin IGV). En FINISHED_GOOD apunta a un `productId` del catálogo. En SERVICE y
/// EXPENSE es solo descripción y montos.
model PurchaseItem {
  id          String   @id @default(uuid()) @db.Uuid
  purchaseId  String   @map("purchase_id") @db.Uuid
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lineNumber  Int      @map("line_number")
  productId   String?  @map("product_id") @db.Uuid
  product     Product? @relation(fields: [productId], references: [id])
  description String   @db.VarChar(240)
  qty         Decimal  @db.Decimal(16, 3)
  unit        String   @db.VarChar(20)
  /// Precio unitario SIN IGV (D-038).
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 4)
  subtotal    Decimal  @db.Decimal(18, 4)
  igv         Decimal  @db.Decimal(18, 4)
  total       Decimal  @db.Decimal(18, 4)
  finishId    String?  @map("finish_id") @db.Uuid
  finish      Finish?  @relation(fields: [finishId], references: [id])
  /// D-085: color de la bobina que esta línea da de alta. Solo en compras `COIL` de
  /// material prepintado; el XML de factura no lo trae, así que esas bobinas nacen sin
  /// color y se lo pone después la edición de la bobina (RF-20).
  colorId     String?  @map("color_id") @db.Uuid
  color       Color?   @relation(fields: [colorId], references: [id])
  widthMm     Decimal? @map("width_mm") @db.Decimal(8, 2)
  thicknessMm Decimal? @map("thickness_mm") @db.Decimal(6, 2)

  coil Coil?

  @@unique([purchaseId, lineNumber])
  @@index([purchaseId])
  @@map("purchase_items")
}

/// Pago a proveedor imputado a una compra (D-039). Una compra admite N pagos
/// parciales; el saldo se calcula (total − pagos vigentes), nunca se almacena.
/// Anular un pago (Sesión M-2, cierra D-039) es append-only, igual que `CoilSplit`
/// (RF-16) y `CuttingOrderCoil` (D-052): la fila nunca se borra, se marca revertida.
/// El motivo de la anulación va al `audit_log` (RF-95), no a esta tabla.
model SupplierPayment {
  id           String        @id @default(uuid()) @db.Uuid
  purchaseId   String        @map("purchase_id") @db.Uuid
  purchase     Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  amount       Decimal       @db.Decimal(18, 4)
  currency     Currency
  exchangeRate Decimal       @map("exchange_rate") @db.Decimal(10, 4)
  method       PaymentMethod
  reference    String?       @db.VarChar(80)
  createdById  String        @map("created_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedById String?       @map("reversed_by_id") @db.Uuid
  reversedAt   DateTime?     @map("reversed_at") @db.Timestamptz(3)

  @@index([purchaseId])
  @@map("supplier_payments")
}

/// Bobina de acero (RF-10..RF-14). `code` sigue RF-13
/// (`{supplier.code}-{finishCode}-{thicknessMm}-{weightKg}-{correlativo}`) y `typeKey`
/// sigue RF-14 (`{finishCode}-{thicknessMm}`, sin ancho). `unitCostPerKg` es sin IGV
/// (D-038) y en Fase 2b lo puede subir el landed cost (D-043). `parentCoilId`/`splitId`
/// apuntan a la madre y al partido que creó la bobina hija (RF-15).
model Coil {
  id                 String                       @id @default(uuid()) @db.Uuid
  code               String                       @unique @db.VarChar(60)
  typeKey            String                       @map("type_key") @db.VarChar(40)
  /// D-049: `COIL` (bobina) o `STRIP` (fleje, hija de `parentCoilId`).
  kind               CoilKind                     @default(COIL)
  businessLineId     String                       @map("business_line_id") @db.Uuid
  businessLine       BusinessLine                 @relation(fields: [businessLineId], references: [id])
  supplierId         String                       @map("supplier_id") @db.Uuid
  supplier           Supplier                     @relation(fields: [supplierId], references: [id])
  purchaseId         String?                      @map("purchase_id") @db.Uuid
  purchase           Purchase?                    @relation(fields: [purchaseId], references: [id])
  purchaseItemId     String?                      @unique @map("purchase_item_id") @db.Uuid
  purchaseItem       PurchaseItem?                @relation(fields: [purchaseItemId], references: [id])
  finishId           String                       @map("finish_id") @db.Uuid
  finish             Finish                       @relation(fields: [finishId], references: [id])
  weightKg           Decimal                      @map("weight_kg") @db.Decimal(12, 3)
  widthMm            Decimal                      @map("width_mm") @db.Decimal(8, 2)
  thicknessMm        Decimal                      @map("thickness_mm") @db.Decimal(6, 2)
  /// D-085: color de la bobina. Las prepintadas lo llevan, las galvanizadas van en null. El
  /// filtro de la OP de coberturas exige **igualdad estricta** contra el color del producto,
  /// null incluido: un producto sin color solo monta bobina sin color.
  colorId            String?                      @map("color_id") @db.Uuid
  color              Color?                       @relation(fields: [colorId], references: [id])
  currency           Currency
  exchangeRate       Decimal                      @map("exchange_rate") @db.Decimal(10, 4)
  unitCostPerKg      Decimal                      @map("unit_cost_per_kg") @db.Decimal(18, 4)
  totalCost          Decimal                      @map("total_cost") @db.Decimal(18, 4)
  totalCostPen       Decimal                      @map("total_cost_pen") @db.Decimal(18, 4)
  status             CoilStatus                   @default(OPEN)
  parentCoilId       String?                      @map("parent_coil_id") @db.Uuid
  parentCoil         Coil?                        @relation("CoilParent", fields: [parentCoilId], references: [id])
  childCoils         Coil[]                       @relation("CoilParent")
  /// Partido que creó esta bobina hija (RF-15). Null en una bobina de compra.
  splitId            String?                      @map("split_id") @db.Uuid
  split              CoilSplit?                   @relation("SplitChildren", fields: [splitId], references: [id])
  splitsAsParent     CoilSplit[]                  @relation("SplitParent")
  /// Recepción de corte tercerizado que creó este fleje (RF-41). Null salvo `kind=STRIP`
  /// nacido de una orden de corte (D-049); un fleje de partido interno usa `splitId`.
  cuttingOrderCoilId String?                      @map("cutting_order_coil_id") @db.Uuid
  cuttingOrderCoil   CuttingOrderCoil?            @relation("CuttingOrderCoilStrips", fields: [cuttingOrderCoilId], references: [id])
  /// Órdenes de corte en las que esta bobina fue la enviada (RF-40), vía `CuttingOrderCoil.coilId`.
  cuttingOrderSends  CuttingOrderCoil[]           @relation("CuttingOrderCoilSource")
  /// Asignaciones de este fleje a órdenes de producción (RF-34, Fase 4, D-060).
  productionInputs   ProductionOrderConsumption[]
  /// Observaciones editables mientras la bobina está abierta (RF-20).
  notes              String?                      @db.VarChar(500)
  createdById        String                       @map("created_by_id") @db.Uuid
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([businessLineId, status])
  @@index([typeKey])
  @@index([supplierId])
  @@index([parentCoilId])
  @@index([splitId])
  @@index([kind, typeKey])
  @@index([cuttingOrderCoilId])
  /// El índice del filtro de la OP de coberturas (D-086): abiertas de una línea, por color
  /// y espesor. El rango de tolerancia lo resuelve el planner sobre `thickness_mm`.
  @@index([businessLineId, status, colorId, thicknessMm])
  @@map("coils")
}

/// Partido de bobina (RF-15). Agrupa la salida de la madre y las entradas de las hijas
/// para poder revertirlo entero (RF-16): los movimientos de kardex del partido llevan
/// `refType=SPLIT` y `refId` = este id.
///
/// El peso se prorratea **por ancho** sobre `Σ anchos de hijas + kerfLossMm`, así que
/// la merma de corte se lleva su parte del peso y la suma cierra exactamente contra
/// `splitWeightKg`. La madre conserva su ancho: lo que se parte es una porción del
/// largo del rollo, no el ancho de la bobina física.
model CoilSplit {
  id            String          @id @default(uuid()) @db.Uuid
  parentCoilId  String          @map("parent_coil_id") @db.Uuid
  parentCoil    Coil            @relation("SplitParent", fields: [parentCoilId], references: [id])
  /// Kilos de la madre que entran al partido (salida `OUT` de kardex).
  splitWeightKg Decimal         @map("split_weight_kg") @db.Decimal(12, 3)
  /// Merma de corte declarada, en mm de ancho.
  kerfLossMm    Decimal         @map("kerf_loss_mm") @db.Decimal(8, 2)
  /// Kilos que se lleva esa merma; `splitWeightKg` − Σ pesos de hijas.
  kerfLossKg    Decimal         @map("kerf_loss_kg") @db.Decimal(12, 3)
  status        CoilSplitStatus @default(ACTIVE)
  createdById   String          @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  revertedById  String?         @map("reverted_by_id") @db.Uuid
  revertedAt    DateTime?       @map("reverted_at") @db.Timestamptz(3)

  children Coil[] @relation("SplitChildren")

  @@index([parentCoilId])
  @@map("coil_splits")
}

// ---------------------------------------------------------------------------
// Fase 3 — Corte tercerizado y flejes (RF-40..42, D-049/D-050)
// ---------------------------------------------------------------------------

/// Orden de corte tercerizado (RF-40..42). Agrupa una o más bobinas enviadas al mismo
/// proveedor de corte (`providesCuttingService=true`) en el mismo envío. El envío NO
/// mueve kardex (D-050): cada bobina de la orden pasa a `IN_THIRD_PARTY` y el kardex real
/// se emite recién al recibirla (`CuttingOrderCoil`).
model CuttingOrder {
  id             String             @id @default(uuid()) @db.Uuid
  supplierId     String             @map("supplier_id") @db.Uuid
  supplier       Supplier           @relation(fields: [supplierId], references: [id])
  /// Línea de negocio de las bobinas enviadas; todas las de una misma orden comparten
  /// línea (se valida al enviar), así que vive acá para filtrar sin unir con `coils`.
  businessLineId String             @map("business_line_id") @db.Uuid
  businessLine   BusinessLine       @relation(fields: [businessLineId], references: [id])
  status         CuttingOrderStatus @default(SENT)
  sentAt         DateTime           @default(now()) @map("sent_at") @db.Timestamptz(3)
  cancelledAt    DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  notes          String?            @db.VarChar(500)
  createdById    String             @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  coils     CuttingOrderCoil[]
  purchases Purchase[]

  @@index([supplierId, status])
  @@index([businessLineId, status])
  @@map("cutting_orders")
}

/// Una bobina dentro de una orden de corte, con su plan de anchos y —tras recibirla— lo
/// que realmente volvió. `widthPlanMm`/`receivedWidthsMm` son arrays JSON
/// `[{ widthMm, stripsCount }]` (mismo shape que el partido interno, RF-15); comparar
/// ambos es lo que la vista usa para mostrar la diferencia plan vs. real.
model CuttingOrderCoil {
  id                 String                 @id @default(uuid()) @db.Uuid
  cuttingOrderId     String                 @map("cutting_order_id") @db.Uuid
  cuttingOrder       CuttingOrder           @relation(fields: [cuttingOrderId], references: [id], onDelete: Cascade)
  coilId             String                 @map("coil_id") @db.Uuid
  coil               Coil                   @relation("CuttingOrderCoilSource", fields: [coilId], references: [id])
  widthPlanMm        Json                   @map("width_plan_mm")
  expectedKerfLossMm Decimal                @map("expected_kerf_loss_mm") @db.Decimal(8, 2)
  status             CuttingOrderCoilStatus @default(SENT)
  receivedAt         DateTime?              @map("received_at") @db.Timestamptz(3)
  receivedWidthsMm   Json?                  @map("received_widths_mm")
  /// Kilos realmente recibidos (input del operario, RF-41); base del prorrateo de `planCoilSplit`.
  receivedWeightKg   Decimal?               @map("received_weight_kg") @db.Decimal(12, 3)
  receivedKerfLossMm Decimal?               @map("received_kerf_loss_mm") @db.Decimal(8, 2)
  /// Kilos que se llevó la merma de corte real; `receivedWeightKg` − Σ pesos de flejes.
  receivedKerfLossKg Decimal?               @map("received_kerf_loss_kg") @db.Decimal(12, 3)
  cancelledAt        DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  /// Última reversa de recepción (Fase 3b). La fila vuelve a `SENT` y estos campos quedan
  /// como rastro de que ya se recibió y se corrigió una vez; `receive()` los limpia si la
  /// fila se vuelve a recibir después.
  revertedById       String?                @map("reverted_by_id") @db.Uuid
  revertedAt         DateTime?              @map("reverted_at") @db.Timestamptz(3)
  createdById        String                 @map("created_by_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  strips Coil[] @relation("CuttingOrderCoilStrips")

  @@index([cuttingOrderId])
  @@index([coilId])
  @@map("cutting_order_coils")
}

// ---------------------------------------------------------------------------
// Fase 4 — Producción de drywall y terminal `/planta` (RF-32..35, RF-38, RF-39)
// ---------------------------------------------------------------------------

/// Receta de un producto fabricado (D-059). En v1 hay **una receta por producto** y un
/// solo insumo: el fleje. Un fleje no es un producto de catálogo (D-049: es una fila de
/// `coils`), así que se identifica por acabado + espesor + ancho — exactamente el criterio
/// con el que RF-42 agrupa el stock de flejes.
///
/// `kgPerPiece` es el kilo teórico de fleje que consume una pieza (D-047, D-055). Se
/// sugiere desde la geometría (`inputWidthMm × thicknessMm × pieceLengthMm × densityFactor`
/// del acabado) y el maestro puede sobreescribirlo con el valor medido en planta.
model ProductBom {
  id               String         @id @default(uuid()) @db.Uuid
  productId        String         @unique @map("product_id") @db.Uuid
  product          Product        @relation(fields: [productId], references: [id])
  /// D-087: `DRYWALL` (Fase 4) o `ROOFING` (Fase 6). Decide qué columnas son obligatorias
  /// y qué servicio opera la orden que nace de esta receta.
  kind             ProductBomKind @default(DRYWALL)
  finishId         String         @map("finish_id") @db.Uuid
  finish           Finish         @relation(fields: [finishId], references: [id])
  /// Espesor del material de entrada. En coberturas es también el espesor del producto —
  /// rolar no cambia el espesor— y es lo que el filtro de bobina compara con tolerancia
  /// (D-086).
  inputThicknessMm Decimal        @map("input_thickness_mm") @db.Decimal(6, 2)
  /// Ancho exacto del fleje que consume el perfil. **Solo DRYWALL**: una OP de coberturas
  /// monta la bobina que haya y su ancho real es el que entra al kilo teórico (D-047), así
  /// que fijarlo en la receta solo dejaría fuera rollos válidos.
  inputWidthMm     Decimal?       @map("input_width_mm") @db.Decimal(8, 2)
  /// Largo de una pieza terminada, en mm. Solo alimenta el cálculo sugerido de `kgPerPiece`.
  /// **Solo DRYWALL**: en coberturas a medida el largo lo pone el pedido (D-083), y en una
  /// plancha de catálogo vive en el propio SKU.
  pieceLengthMm    Decimal?       @map("piece_length_mm") @db.Decimal(8, 2)
  /// **Solo DRYWALL**. El kilo teórico de una cobertura no es constante: sale del ancho y
  /// el espesor de la bobina montada por el largo reportado (D-047), así que no hay nada
  /// que guardar en el maestro.
  kgPerPiece       Decimal?       @map("kg_per_piece") @db.Decimal(12, 3)
  isActive         Boolean        @default(true) @map("is_active")
  createdById      String         @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  productionOrders ProductionOrder[]

  @@index([finishId, inputThicknessMm, inputWidthMm])
  @@index([kind, finishId, inputThicknessMm])
  @@map("product_boms")
}

/// Orden de producción de drywall (RF-34, D-058). Consume flejes y produce piezas; la
/// unidad primaria del producto terminado son **piezas** (D-055), no kilos.
///
/// `seq` es el correlativo que la UI muestra como `OP-000123`: un `serial` de Postgres,
/// así dos altas concurrentes no compiten por un contador propio.
/// Los campos de costeo (D-056) se calculan al **cerrar**; mientras la OP está viva son
/// `null` porque el costo real solo se conoce cuando ya no entra ni sale material.
model ProductionOrder {
  id              String                @id @default(uuid()) @db.Uuid
  seq             Int                   @unique @default(autoincrement())
  businessLineId  String                @map("business_line_id") @db.Uuid
  businessLine    BusinessLine          @relation(fields: [businessLineId], references: [id])
  productId       String                @map("product_id") @db.Uuid
  product         Product               @relation(fields: [productId], references: [id])
  bomId           String                @map("bom_id") @db.Uuid
  bom             ProductBom            @relation(fields: [bomId], references: [id])
  /// D-087: qué línea de transformación es. `DRYWALL` consume flejes y reporta piezas;
  /// `ROOFING` consume bobina y reporta largos. El correlativo, los estados, el ledger de
  /// reservas y la auditoría son los mismos para las dos.
  kind            ProductionOrderKind   @default(DRYWALL)
  status          ProductionOrderStatus @default(DRAFT)
  /// Piezas que la corrida se propone producir. Referencia para planta; no bloquea nada.
  targetPieces    Int?                  @map("target_pieces")
  /// D-054: reserva que esta OP consume cuando nace de un pedido. La columna nació en
  /// Fase 4 sin FK (el ledger no existía todavía); Fase 5a la conecta al ledger y le
  /// agrega la relación. Sigue nullable: una OP de drywall sin pedido detrás no reserva
  /// nada (D-048).
  reservationId   String?               @map("reservation_id") @db.Uuid
  reservation     Reservation?          @relation(fields: [reservationId], references: [id])
  notes           String?               @db.VarChar(500)
  /// Cierre (D-057 en drywall, D-089 en coberturas): kilos que salieron como merma de
  /// proceso. En drywall es todo lo asignado que no llegó a ser pieza buena; en coberturas
  /// es el despunte, `consumedKg − Σ kilos teóricos reportados`.
  scrapKg         Decimal?              @map("scrap_kg") @db.Decimal(12, 3)
  /// **Solo ROOFING** (D-089): kilos que planta declara que la bobina consumió de verdad.
  /// Por defecto, la suma de los kilos teóricos reportados (merma cero). Lo que quedó
  /// asignado y no consumido se libera sin merma: la bobina sigue en el almacén, a
  /// diferencia del fleje de drywall, que entra entero a la perfiladora.
  consumedKg      Decimal?              @map("consumed_kg") @db.Decimal(12, 3)
  /// Costeo v1 en soles (D-056, D-042). `overheadCostPen` es el hook de D-035: en v1
  /// siempre 0, porque no hay mano de obra ni overhead estándar todavía.
  materialCostPen Decimal?              @map("material_cost_pen") @db.Decimal(18, 4)
  overheadCostPen Decimal?              @map("overhead_cost_pen") @db.Decimal(18, 4)
  totalCostPen    Decimal?              @map("total_cost_pen") @db.Decimal(18, 4)
  unitCostPen     Decimal?              @map("unit_cost_pen") @db.Decimal(18, 4)
  createdById     String                @map("created_by_id") @db.Uuid
  closedById      String?               @map("closed_by_id") @db.Uuid
  closedAt        DateTime?             @map("closed_at") @db.Timestamptz(3)
  cancelledById   String?               @map("cancelled_by_id") @db.Uuid
  cancelledAt     DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  consumptions ProductionOrderConsumption[]
  reports      ProductionReport[]
  /// D-084: el plan de corte copiado del pedido. Vacío en una OP de drywall.
  items        ProductionOrderItem[]

  @@index([businessLineId, status])
  @@index([productId])
  @@index([kind, status])
  @@map("production_orders")
}

/// Fleje puesto a disposición de una OP (D-060). **Asignar no mueve kardex**, mismo
/// criterio que D-050 con el envío a corte: el fleje sigue siendo de la empresa y sigue
/// en el almacén hasta que un reporte de piezas lo consume de verdad. Por eso un fleje
/// con una asignación viva queda bloqueado para cualquier otra operación (merma, partido,
/// anulación, corte, otra OP) mientras la OP no se cierre, se anule o lo libere.
///
/// `consumedKg` avanza con cada reporte de piezas y, al cerrar, con la merma de proceso;
/// nunca supera `assignedKg`.
model ProductionOrderConsumption {
  id                String          @id @default(uuid()) @db.Uuid
  productionOrderId String          @map("production_order_id") @db.Uuid
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  coilId            String          @map("coil_id") @db.Uuid
  coil              Coil            @relation(fields: [coilId], references: [id])
  assignedKg        Decimal         @map("assigned_kg") @db.Decimal(12, 3)
  consumedKg        Decimal         @default(0) @map("consumed_kg") @db.Decimal(12, 3)
  /// No nula cuando el fleje dejó de estar tomado por esta OP (liberación, anulación o
  /// cierre). Es lo que hace que el guardrail deje de aplicar.
  releasedAt        DateTime?       @map("released_at") @db.Timestamptz(3)
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productionOrderId])
  @@index([coilId, releasedAt])
  @@map("production_order_consumptions")
}

/// Reporte parcial de piezas producidas (D-058, patrón RF-41). Cada reporte emite el
/// kardex completo de lo que produjo: la salida de los flejes por los kilos teóricos que
/// esas piezas consumen (`refType=PRODUCTION`) y la entrada de las piezas al producto
/// terminado, valorizada exactamente por lo que salió de los flejes.
///
/// Revertirlo (D-060) anula esos movimientos en bloque y devuelve los kilos a la
/// asignación; la fila queda `REVERTED`, nunca se borra (§3.2).
model ProductionReport {
  id                String                 @id @default(uuid()) @db.Uuid
  /// Orden real de los reportes de una OP. No se puede usar `createdAt`: en Postgres
  /// `now()` es el instante en que **empezó la transacción**, así que dos reportes
  /// concurrentes pueden quedar empatados o invertidos respecto al orden de commit, y
  /// "revertir solo el último vigente" dejaría de ser cierto. Mismo criterio que el
  /// kardex, que ordena por su `id` bigserial y no por `at`.
  seq               Int                    @default(autoincrement())
  productionOrderId String                 @map("production_order_id") @db.Uuid
  productionOrder   ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  /// Piezas buenas. Unidad primaria del producto terminado de drywall (D-055) y de la
  /// plancha de catálogo; en una cobertura a medida es cuántas planchas salieron, y lo que
  /// entra al kardex son los metros de `metersM`.
  pieces            Int
  /// **Solo ROOFING a medida** (D-083): metros lineales que entraron al kardex en este
  /// reporte, `Σ cantidad × largo` de `pieces` detallados. Null en drywall, donde la
  /// unidad del producto terminado son piezas y no hay nada que derivar.
  metersM           Decimal?               @map("meters_m") @db.Decimal(16, 3)
  /// Kilos de material que esas piezas consumen. En drywall, `pieces × bom.kgPerPiece`; en
  /// coberturas, la geometría de la bobina montada por los largos reportados (D-047).
  theoreticalKg     Decimal                @map("theoretical_kg") @db.Decimal(12, 3)
  /// Valor en soles que salió de los flejes por este reporte (D-042).
  materialCostPen   Decimal                @map("material_cost_pen") @db.Decimal(18, 4)
  /// `materialCostPen / pieces`: costo con el que las piezas entraron al kardex.
  unitCostPen       Decimal                @map("unit_cost_pen") @db.Decimal(18, 4)
  status            ProductionReportStatus @default(ACTIVE)
  notes             String?                @db.VarChar(240)
  createdById       String                 @map("created_by_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  revertedById      String?                @map("reverted_by_id") @db.Uuid
  revertedAt        DateTime?              @map("reverted_at") @db.Timestamptz(3)

  /// D-083: los largos que de verdad salieron. Vacío en un reporte de drywall.
  piecesDetail ProductionReportPiece[]

  @@unique([seq])
  @@index([productionOrderId, status])
  @@map("production_reports")
}

// ---------------------------------------------------------------------------
// Fase 5a — cotización, pedido y reserva (RF-61, RF-62, RF-65, RF-69; D-064..D-069)
// ---------------------------------------------------------------------------

/// Cotización (RF-61). Simulación de precio: **no reserva stock** (D-054). Todo el
/// dominio comercial va en soles (D-064), así que no hay moneda ni tipo de cambio acá.
/// Los montos son sin IGV en `subtotalPen`, con el IGV separado (D-068).
///
/// `seq` es el correlativo que la UI muestra como `COT-000123`: un `serial` de Postgres,
/// igual que `production_orders.seq`, para que dos altas concurrentes no compitan por un
/// contador propio.
model Quotation {
  id             String          @id @default(uuid()) @db.Uuid
  seq            Int             @unique @default(autoincrement())
  customerId     String          @map("customer_id") @db.Uuid
  customer       Customer        @relation(fields: [customerId], references: [id])
  businessLineId String          @map("business_line_id") @db.Uuid
  businessLine   BusinessLine    @relation(fields: [businessLineId], references: [id])
  status         QuotationStatus @default(DRAFT)
  issueDate      DateTime        @map("issue_date") @db.Date
  /// Último día en que la cotización se puede confirmar (D-069). El job diario marca
  /// `EXPIRED` a las que ya pasaron; `confirm()` lo revalida igual, por si el job no corrió.
  validUntil     DateTime        @map("valid_until") @db.Date
  subtotalPen    Decimal         @map("subtotal_pen") @db.Decimal(18, 4)
  igvPen         Decimal         @map("igv_pen") @db.Decimal(18, 4)
  totalPen       Decimal         @map("total_pen") @db.Decimal(18, 4)
  notes          String?         @db.VarChar(500)
  /// Key en R2 del PDF generado al emitir (D-068). Se regenera si la cotización se reemite.
  pdfKey         String?         @map("pdf_key") @db.VarChar(300)
  createdById    String          @map("created_by_id") @db.Uuid
  emittedAt      DateTime?       @map("emitted_at") @db.Timestamptz(3)
  confirmedAt    DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  expiredAt      DateTime?       @map("expired_at") @db.Timestamptz(3)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelledById  String?         @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  items       QuotationItem[]
  /// Pedidos nacidos de esta cotización. Es una lista y no uno solo porque anular un
  /// pedido la devuelve a `EMITIDA` y se puede volver a confirmar; como mucho uno de
  /// ellos está vivo a la vez.
  salesOrders SalesOrder[]

  @@index([customerId, status])
  @@index([businessLineId, status])
  @@index([status, validUntil])
  @@map("quotations")
}

/// Línea de una cotización. `listPricePen` es el precio del maestro al momento de cotizar
/// y `unitPricePen` el que el vendedor dejó: guardar los dos es lo que hace auditable el
/// descuento (D-068).
///
/// `reserveItemType`/`reserveItemId`/`reserveQty` declaran qué reservará la confirmación:
/// el propio producto (perfiles, trading) o los kilos de una bobina concreta (coberturas,
/// que se fabrican contra el pedido y todavía no tienen producto terminado en stock).
model QuotationItem {
  id              String            @id @default(uuid()) @db.Uuid
  quotationId     String            @map("quotation_id") @db.Uuid
  quotation       Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  lineNumber      Int               @map("line_number")
  productId       String            @map("product_id") @db.Uuid
  product         Product           @relation(fields: [productId], references: [id])
  description     String            @db.VarChar(240)
  qty             Decimal           @db.Decimal(16, 3)
  unit            String            @db.VarChar(20)
  listPricePen    Decimal?          @map("list_price_pen") @db.Decimal(18, 4)
  unitPricePen    Decimal           @map("unit_price_pen") @db.Decimal(18, 4)
  subtotalPen     Decimal           @map("subtotal_pen") @db.Decimal(18, 4)
  igvPen          Decimal           @map("igv_pen") @db.Decimal(18, 4)
  totalPen        Decimal           @map("total_pen") @db.Decimal(18, 4)
  reserveItemType InventoryItemType @map("reserve_item_type")
  reserveItemId   String            @map("reserve_item_id") @db.Uuid
  reserveQty      Decimal           @map("reserve_qty") @db.Decimal(16, 3)
  reserveUnit     String            @map("reserve_unit") @db.VarChar(20)

  /// D-083: los largos de una línea compuesta de cobertura a medida. `qty` de la línea es
  /// la suma `Σ cantidad × largo` en metros y `unit` es `MTR`. Vacío en una línea simple.
  pieces QuotationItemPiece[]

  @@unique([quotationId, lineNumber])
  @@index([quotationId])
  @@map("quotation_items")
}

/// Pedido (D-065). Nace de confirmar una cotización o, en las líneas que no la exigen,
/// de un alta directa. Confirmar crea el pedido y sus reservas en **una sola
/// transacción**: si una línea no tiene disponible, no se crea nada (D-054).
model SalesOrder {
  id                   String           @id @default(uuid()) @db.Uuid
  seq                  Int              @unique @default(autoincrement())
  /// Cotización de origen. Null en un pedido directo (línea con cotización opcional).
  ///
  /// **No es único a propósito.** Anular un pedido devuelve la cotización a `EMITIDA` si
  /// sigue vigente (D-065), y desde ahí se puede volver a confirmar: con una restricción
  /// de unicidad, ese segundo intento chocaría contra el pedido anulado y la cotización
  /// quedaría inconfirmable para siempre. La regla real —"una cotización tiene como mucho
  /// un pedido **vivo**"— la sostiene el estado de la cotización, que solo se confirma
  /// desde `EMITIDA`, bajo el lock de su propia fila.
  quotationId          String?          @map("quotation_id") @db.Uuid
  quotation            Quotation?       @relation(fields: [quotationId], references: [id])
  customerId           String           @map("customer_id") @db.Uuid
  customer             Customer         @relation(fields: [customerId], references: [id])
  businessLineId       String           @map("business_line_id") @db.Uuid
  businessLine         BusinessLine     @relation(fields: [businessLineId], references: [id])
  status               SalesOrderStatus @default(CONFIRMED)
  issueDate            DateTime         @map("issue_date") @db.Date
  subtotalPen          Decimal          @map("subtotal_pen") @db.Decimal(18, 4)
  igvPen               Decimal          @map("igv_pen") @db.Decimal(18, 4)
  totalPen             Decimal          @map("total_pen") @db.Decimal(18, 4)
  notes                String?          @db.VarChar(500)
  createdById          String           @map("created_by_id") @db.Uuid
  cancelledById        String?          @map("cancelled_by_id") @db.Uuid
  cancelledAt          DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  /// Fecha prometida de entrega (Fase 7, D-096). Opcional; el vendedor la fija solo al
  /// confirmar/crear el pedido, después solo ADMINISTRADOR (`PATCH .../promised-delivery-date`).
  promisedDeliveryDate DateTime?        @map("promised_delivery_date") @db.Date
  /// Prioridad manual excepcional de la cola de producción (D-094): cachea el último valor
  /// vigente para ordenar sin releer `audit_log`, que sigue siendo la fuente de "quién y cuándo".
  priorityAt           DateTime?        @map("priority_at") @db.Timestamptz(3)
  priorityById         String?          @map("priority_by_id") @db.Uuid
  priorityReason       String?          @map("priority_reason") @db.VarChar(500)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  items           SalesOrderItem[]
  reservations    Reservation[]
  fiscalDocuments FiscalDocument[]
  dispatches      Dispatch[]
  /// Venta de mostrador que creó este pedido (Fase 7b, D-100). Null en el resto.
  posSale         PosSale?

  @@index([customerId, status])
  @@index([businessLineId, status])
  @@index([quotationId])
  @@map("sales_orders")
}

/// Línea de un pedido: copia congelada de la línea de la cotización (o del alta directa).
/// Los precios no se recalculan nunca contra el maestro después de confirmar.
model SalesOrderItem {
  id              String            @id @default(uuid()) @db.Uuid
  salesOrderId    String            @map("sales_order_id") @db.Uuid
  salesOrder      SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lineNumber      Int               @map("line_number")
  productId       String            @map("product_id") @db.Uuid
  product         Product           @relation(fields: [productId], references: [id])
  description     String            @db.VarChar(240)
  qty             Decimal           @db.Decimal(16, 3)
  unit            String            @db.VarChar(20)
  listPricePen    Decimal?          @map("list_price_pen") @db.Decimal(18, 4)
  unitPricePen    Decimal           @map("unit_price_pen") @db.Decimal(18, 4)
  subtotalPen     Decimal           @map("subtotal_pen") @db.Decimal(18, 4)
  igvPen          Decimal           @map("igv_pen") @db.Decimal(18, 4)
  totalPen        Decimal           @map("total_pen") @db.Decimal(18, 4)
  reserveItemType InventoryItemType @map("reserve_item_type")
  reserveItemId   String            @map("reserve_item_id") @db.Uuid
  reserveQty      Decimal           @map("reserve_qty") @db.Decimal(16, 3)
  reserveUnit     String            @map("reserve_unit") @db.VarChar(20)

  /// **Plural desde D-088.** Una línea sostiene a la vez la promesa de materia prima que le
  /// queda y la del producto terminado que la producción ya fabricó: al reportar largos, la
  /// OP descuenta de la primera los kilos que consumió y abre (o aumenta) la segunda por los
  /// metros que entraron al kardex. Antes de Fase 6 era una sola y el índice único lo
  /// garantizaba; ahora el único es `(línea, itemType, itemId)`.
  reservations  Reservation[]
  invoiceItems  FiscalDocumentItem[]
  dispatchItems DispatchItem[]
  /// D-083: copia congelada de los subítems de largo de la cotización.
  pieces        SalesOrderItemPiece[]

  @@unique([salesOrderId, lineNumber])
  @@index([salesOrderId])
  @@map("sales_order_items")
}

/// Ledger de reservas (D-054, D-066). **Fuera del kardex a propósito**: una reserva es una
/// promesa comercial, no un hecho físico, y un `OUT` ficticio ensuciaría el promedio
/// ponderado y el valorizado (RF-90..94) con una salida que todavía no ocurrió — mismo
/// argumento que D-050 usa para el envío a corte.
///
/// La fila apunta al ítem con **el mismo par `(itemType, itemId)` que usa
/// `inventory_balances`**, que es lo que permite comprobar la invariante
/// `disponible ≥ reservado` bajo el mismo lock de saldo que ya toma el kardex.
/// Append-only en el mismo sentido que el resto del proyecto: una reserva nunca se borra,
/// cambia de estado y guarda quién y cuándo.
model Reservation {
  id               String            @id @default(uuid()) @db.Uuid
  salesOrderId     String            @map("sales_order_id") @db.Uuid
  salesOrder       SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  /// Una línea reserva **una vez por ítem** (D-088). Al confirmar es siempre una sola fila,
  /// y eso sigue haciendo idempotente la confirmación; la segunda aparece recién cuando la
  /// producción de coberturas convierte la materia prima prometida en producto terminado y
  /// la promesa se traslada de la bobina a los metros fabricados.
  salesOrderItemId String            @map("sales_order_item_id") @db.Uuid
  salesOrderItem   SalesOrderItem    @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  itemType         InventoryItemType @map("item_type")
  itemId           String            @map("item_id") @db.Uuid
  /// **Lo que todavía está prometido**, no la promesa original (D-074, Fase 5b): un
  /// despacho parcial descuenta de acá lo que se llevó, y al llegar a cero la reserva pasa
  /// a `CONSUMIDA`. La promesa original vive en `sales_order_items.reserve_qty`, que no se
  /// toca nunca, así que bajar esta cifra no pierde información — y mantenerla al día es lo
  /// que hace que el resto de la línea siga protegido después de un despacho parcial.
  qty              Decimal           @db.Decimal(16, 3)
  unit             String            @db.VarChar(20)
  status           ReservationStatus @default(ACTIVE)
  createdById      String            @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  consumedAt       DateTime?         @map("consumed_at") @db.Timestamptz(3)
  releasedById     String?           @map("released_by_id") @db.Uuid
  releasedAt       DateTime?         @map("released_at") @db.Timestamptz(3)

  productionOrders ProductionOrder[]

  /// D-088: una línea, un ítem, una reserva. Es lo que hace que trasladar la promesa de la
  /// bobina al producto terminado sea un `upsert` y no una decisión sobre cuál de dos filas
  /// del mismo ítem vale.
  @@unique([salesOrderItemId, itemType, itemId])
  /// El índice que sostiene la invariante: sumar lo reservado vivo de un ítem es una
  /// sola pasada por índice, y se consulta en cada salida de kardex de ese ítem.
  @@index([itemType, itemId, status])
  @@index([salesOrderId])
  @@index([salesOrderItemId, status])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Fase 5b — facturación electrónica, guía de remisión, despacho y cobranza
// (RF-70, RF-74..RF-79, RF-86..RF-89; D-070..D-078)
// ---------------------------------------------------------------------------

/// Series y correlativos del punto de emisión (D-072).
///
/// Hay **una serie activa por tipo de documento**; para la nota de crédito, una por tipo
/// de comprobante afectado (`FC01` afecta facturas, `BC01` boletas). El correlativo se
/// toma con `UPDATE … SET correlative = correlative + 1 … RETURNING`, el mismo patrón
/// atómico de `suppliers.coil_seq`, y **en el momento de enviar**, no al crear el
/// borrador: un correlativo existe solo si hubo intento real de emisión.
model FiscalSeries {
  id              String         @id @default(uuid()) @db.Uuid
  docType         FiscalDocType  @map("doc_type")
  /// `F001`, `B001`, `FC01`, `BC01`, `T001`. Cuatro caracteres, formato SUNAT.
  series          String         @unique @db.VarChar(4)
  /// Solo en series de `NOTA_CREDITO`: tipo del comprobante que afecta. Null en el resto.
  /// La unicidad "una serie activa por combinación" la sostiene un índice parcial creado
  /// en la migración; Postgres trata los NULL como distintos y un `@@unique` no bastaría.
  affectedDocType FiscalDocType? @map("affected_doc_type")
  /// Último correlativo entregado. `0` = todavía no se emitió ninguno de esta serie.
  correlative     Int            @default(0)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents FiscalDocument[]

  @@index([docType, isActive])
  @@map("fiscal_series")
}

/// Configuración del módulo, fila única (D-073).
///
/// `providerOffline` es el interruptor de contingencia manual: durante una caída conocida
/// del PSE, un ADMINISTRADOR lo levanta y las emisiones dejan de salir a la red —el
/// documento igual toma correlativo y habilita el despacho— hasta que lo baja.
/// `alertAfterHours` es el umbral tras el cual un documento sin aceptar deja de ser "en
/// camino" y pasa a ser un problema visible en la lista y en el menú.
model InvoicingSetting {
  id              String   @id @default(uuid()) @db.Uuid
  providerOffline Boolean  @default(false) @map("provider_offline")
  alertAfterHours Int      @default(6) @map("alert_after_hours")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("invoicing_settings")
}

/// Documento electrónico: comprobante de pago (factura, boleta, nota de crédito) o guía
/// de remisión remitente (D-071..D-073).
///
/// Los cuatro comparten tabla porque comparten **todo lo que cuesta**: la máquina de
/// estados, la asignación de correlativo, el job de reintento, los archivos en R2 y el
/// puerto del PSE. Lo que no comparten vive aparte: los importes y las líneas son de los
/// comprobantes (un `CHECK` obliga a la guía a llevarlos en cero y sin líneas), y los
/// datos de transporte de la guía viven en `dispatches`.
///
/// **Todo va en soles** (D-064): no hay columna de moneda ni de tipo de cambio.
model FiscalDocument {
  id      String               @id @default(uuid()) @db.Uuid
  docType FiscalDocType        @map("doc_type")
  status  FiscalDocumentStatus @default(DRAFT)
  origin  FiscalDocumentOrigin @default(ISSUED_HERE)

  /// Serie, correlativo y número legible. **Null mientras es borrador** (D-072): se
  /// asignan al enviar. `number` es `serie-correlativo` con el correlativo a 8 dígitos
  /// (`F001-00000123`), que es el formato con el que SUNAT identifica el documento.
  ///
  /// La unicidad de `number` es **parcial** desde RF-72 (`WHERE archived_at IS NULL`, índice
  /// creado en la migración): una reimportación deja conviviendo la versión archivada y la
  /// vigente con el mismo número, y solo la vigente tiene que ser única.
  seriesId    String?       @map("series_id") @db.Uuid
  /// `seriesRef` y no `series` para no chocar con `FiscalSeries.series`, que es el string
  /// que se imprime en el número del documento.
  seriesRef   FiscalSeries? @relation(fields: [seriesId], references: [id])
  correlative Int?
  number      String?       @db.VarChar(20)

  customerId   String      @map("customer_id") @db.Uuid
  customer     Customer    @relation(fields: [customerId], references: [id])
  /// Pedido de origen. Null en una venta directa sin pedido.
  salesOrderId String?     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  /// Despacho que documenta esta guía de remisión. Null en los comprobantes de pago.
  dispatchId   String?     @map("dispatch_id") @db.Uuid
  dispatch     Dispatch?   @relation(fields: [dispatchId], references: [id])

  /// Nota de crédito: comprobante afectado y motivo del catálogo 09. Van juntos o no van
  /// (`CHECK` en la migración): una NC sin documento afectado no es emitible.
  affectedDocumentId String?           @map("affected_document_id") @db.Uuid
  affectedDocument   FiscalDocument?   @relation("AffectedDocument", fields: [affectedDocumentId], references: [id])
  creditNotes        FiscalDocument[]  @relation("AffectedDocument")
  creditNoteReason   CreditNoteReason? @map("credit_note_reason")

  /// Si este documento nació de corregir uno **rechazado**, apunta al rechazado (D-072).
  /// El rechazado conserva su propio correlativo y queda en el historial.
  replacesDocumentId String?         @unique @map("replaces_document_id") @db.Uuid
  replacesDocument   FiscalDocument? @relation("ReplacedDocument", fields: [replacesDocumentId], references: [id])
  replacedBy         FiscalDocument? @relation("ReplacedDocument")

  /// RF-72: la versión anterior que **esta** importación archivó. Misma forma que D-072 y
  /// por el mismo motivo: reimportar no pisa la fila anterior, la deja archivada con sus
  /// líneas y su historial y le pone un sucesor. `archivedAt` marca a la archivada.
  ///
  /// Las dos puntas viven en filas distintas, así que ningún `CHECK` puede exigir que
  /// aparezcan juntas: eso lo sostiene la transacción de `FiscalImportService`. Lo que sí
  /// ata la migración es que solo un documento **importado** archiva o queda archivado.
  supersedesDocumentId String?         @unique @map("supersedes_document_id") @db.Uuid
  supersedesDocument   FiscalDocument? @relation("SupersededDocument", fields: [supersedesDocumentId], references: [id])
  supersededBy         FiscalDocument? @relation("SupersededDocument")
  archivedAt           DateTime?       @map("archived_at") @db.Timestamptz(3)

  issueDate    DateTime     @map("issue_date") @db.Date
  /// Condición de pago y vencimiento de la cuenta por cobrar (D-075). `dueDate` solo en
  /// crédito; sale de `customers.credit_days` y el usuario la puede corregir.
  paymentTerms PaymentTerms @default(CONTADO) @map("payment_terms")
  dueDate      DateTime?    @map("due_date") @db.Date

  subtotalPen Decimal @map("subtotal_pen") @db.Decimal(18, 4)
  igvPen      Decimal @map("igv_pen") @db.Decimal(18, 4)
  totalPen    Decimal @map("total_pen") @db.Decimal(18, 4)

  /// Detracción **informativa** (D-075): se captura a mano y viaja al PSE tal cual. El
  /// sistema no la calcula ni la valida contra el catálogo 54.
  detractionCode      String?  @map("detraction_code") @db.VarChar(10)
  detractionPct       Decimal? @map("detraction_pct") @db.Decimal(6, 2)
  detractionAmountPen Decimal? @map("detraction_amount_pen") @db.Decimal(18, 4)

  /// D-077: quién forzó la boleta a "público en general" por encima del tope de SUNAT.
  /// Null en el caso normal; con valor, es la constancia de que alguien se saltó la regla.
  genericCustomerOverrideById String? @map("generic_customer_override_by_id") @db.Uuid

  notes String? @db.VarChar(500)

  /// D-071: respuesta cruda del PSE, tal cual. **El dominio no la lee nunca**; está para
  /// soporte y para reconstruir qué contestó el proveedor ante una discrepancia.
  providerResponse Json?   @map("provider_response")
  providerTicket   String? @map("provider_ticket") @db.VarChar(80)
  /// Código hash del CDR (la constancia de recepción de SUNAT).
  sunatHash        String? @map("sunat_hash") @db.VarChar(120)
  rejectionCode    String? @map("rejection_code") @db.VarChar(20)
  rejectionMessage String? @map("rejection_message") @db.VarChar(500)

  /// Archivos en R2 (D-007). Los devuelve el PSE ya firmados; se descargan y se guardan.
  pdfKey String? @map("pdf_key") @db.VarChar(300)
  xmlKey String? @map("xml_key") @db.VarChar(300)
  cdrKey String? @map("cdr_key") @db.VarChar(300)

  /// Reintentos del envío (D-073). `sendAttempts` cuenta los intentos reales, no los
  /// encolados: es lo que separa "todavía no salió" de "salió y no entra".
  sendAttempts  Int       @default(0) @map("send_attempts")
  lastSendError String?   @map("last_send_error") @db.VarChar(500)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)

  createdById     String    @map("created_by_id") @db.Uuid
  issuedAt        DateTime? @map("issued_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(3)
  voidRequestedAt DateTime? @map("void_requested_at") @db.Timestamptz(3)
  voidedAt        DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById      String?   @map("voided_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  items    FiscalDocumentItem[]
  payments CustomerPayment[]
  /// Venta de mostrador que emitió este comprobante (Fase 7b, D-100). Null en el resto.
  posSale  PosSale?

  @@index([status, docType])
  @@index([customerId, status])
  @@index([salesOrderId])
  @@index([dispatchId])
  @@index([affectedDocumentId])
  /// El índice del job y de la alerta (D-073): documentos pendientes de envío por antigüedad.
  @@index([status, issuedAt])
  /// RF-71/RF-72: buscar por número al importar, incluidas las versiones ya archivadas
  /// (el índice único parcial solo cubre las vigentes).
  @@index([number])
  @@map("fiscal_documents")
}

/// Línea de un comprobante de pago. **Las guías de remisión no tienen líneas acá**: las
/// suyas son las del despacho, que llevan cantidad y unidad pero ningún importe, y
/// duplicarlas con importes en cero habría hecho que el valorizado de un comprobante
/// dependiera de qué tipo de documento es.
model FiscalDocumentItem {
  id           String         @id @default(uuid()) @db.Uuid
  documentId   String         @map("document_id") @db.Uuid
  document     FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNumber   Int            @map("line_number")
  /// Null en una línea libre (un servicio, un ajuste de nota de crédito).
  productId    String?        @map("product_id") @db.Uuid
  product      Product?       @relation(fields: [productId], references: [id])
  description  String         @db.VarChar(240)
  qty          Decimal        @db.Decimal(16, 3)
  unit         String         @db.VarChar(20)
  unitPricePen Decimal        @map("unit_price_pen") @db.Decimal(18, 4)
  subtotalPen  Decimal        @map("subtotal_pen") @db.Decimal(18, 4)
  igvPen       Decimal        @map("igv_pen") @db.Decimal(18, 4)
  totalPen     Decimal        @map("total_pen") @db.Decimal(18, 4)

  /// Línea del pedido que factura, cuando el comprobante nace de uno. Es lo que permite
  /// saber cuánto de cada línea queda por facturar sin recorrer todos los comprobantes.
  salesOrderItemId String?              @map("sales_order_item_id") @db.Uuid
  salesOrderItem   SalesOrderItem?      @relation(fields: [salesOrderItemId], references: [id])
  /// Línea del comprobante afectado, en una nota de crédito **parcial**.
  affectedItemId   String?              @map("affected_item_id") @db.Uuid
  affectedItem     FiscalDocumentItem?  @relation("AffectedItem", fields: [affectedItemId], references: [id])
  creditedBy       FiscalDocumentItem[] @relation("AffectedItem")

  @@unique([documentId, lineNumber])
  @@index([documentId])
  @@index([salesOrderItemId])
  @@map("fiscal_document_items")
}

/// Despacho de un pedido (D-074). Es el que **saca la mercadería**: mueve kardex, consume
/// la reserva y cierra el pedido cuando cubre el 100 % de sus líneas.
///
/// Los datos de transporte son los de la guía de remisión remitente (D-078) y la
/// modalidad se elige acá, no en configuración: privado lleva vehículo y conductor;
/// público, el transportista. La guía en sí es un `FiscalDocument` que apunta a esta fila.
model Dispatch {
  id           String         @id @default(uuid()) @db.Uuid
  seq          Int            @unique @default(autoincrement())
  salesOrderId String         @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id])
  status       DispatchStatus @default(ISSUED)
  dispatchDate DateTime       @map("dispatch_date") @db.Date

  /// Direcciones de partida y llegada de la guía. La de llegada arranca con la del
  /// cliente y se puede corregir: se despacha a obra tanto como a domicilio fiscal.
  originAddress      String @map("origin_address") @db.VarChar(240)
  destinationAddress String @map("destination_address") @db.VarChar(240)
  /// Ubigeo INEI de seis dígitos. SUNAT lo exige en la guía, y sin él el PSE la rechaza
  /// con el correlativo ya gastado (D-072): por eso se captura en el despacho y no al
  /// emitir. El de partida es casi siempre el del almacén y lo autocompleta la sugerencia.
  originUbigeo       String @map("origin_ubigeo") @db.VarChar(6)
  destinationUbigeo  String @map("destination_ubigeo") @db.VarChar(6)

  transferMode  TransferMode @map("transfer_mode")
  /// Peso bruto total del traslado, obligatorio en la guía.
  totalWeightKg Decimal      @map("total_weight_kg") @db.Decimal(16, 3)
  packageCount  Int?         @map("package_count")

  /// Traslado privado (D-078). Van los cuatro o no va ninguno; lo obliga un `CHECK`.
  vehiclePlate      String?  @map("vehicle_plate") @db.VarChar(10)
  /// Nombres y apellidos **por separado**: SUNAT los pide así y el PSE rechaza la guía si
  /// faltan los apellidos. Partir un nombre completo por espacios acierta con "Juan Pérez
  /// Gómez" y falla con "José Luis Pérez", y esa adivinanza saldría impresa en un
  /// documento fiscal.
  driverGivenNames  String?  @map("driver_given_names") @db.VarChar(80)
  driverFamilyNames String?  @map("driver_family_names") @db.VarChar(80)
  driverDocType     DocType? @map("driver_doc_type")
  driverDocNumber   String?  @map("driver_doc_number") @db.VarChar(20)
  driverLicense     String?  @map("driver_license") @db.VarChar(20)

  /// Traslado público (D-078): el transportista tercero. Su propia GRE está fuera de
  /// alcance; acá solo se lo identifica como responsable del traslado.
  carrierDocNumber String? @map("carrier_doc_number") @db.VarChar(20)
  carrierName      String? @map("carrier_name") @db.VarChar(160)

  notes String? @db.VarChar(500)

  createdById  String    @map("created_by_id") @db.Uuid
  reversedById String?   @map("reversed_by_id") @db.Uuid
  reversedAt   DateTime? @map("reversed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  items     DispatchItem[]
  /// Guías de remisión emitidas para este despacho. Es una lista y no una sola porque una
  /// guía rechazada conserva su correlativo y la corrección se emite aparte (D-072).
  documents FiscalDocument[]
  /// Venta de mostrador que creó este despacho (Fase 7b, D-100). Null en el resto.
  posSale   PosSale?

  @@index([salesOrderId, status])
  @@index([status, dispatchDate])
  @@map("dispatches")
}

/// Línea de un despacho: qué salió, de qué línea del pedido y por qué movimiento de
/// kardex. `movementId` es lo que hace posible la reversa exacta (`InventoryService.reverse`),
/// igual que en el partido de bobina (RF-16) y en la recepción de corte (D-051).
model DispatchItem {
  id         String   @id @default(uuid()) @db.Uuid
  dispatchId String   @map("dispatch_id") @db.Uuid
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  lineNumber Int      @map("line_number")

  salesOrderItemId String         @map("sales_order_item_id") @db.Uuid
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  productId        String         @map("product_id") @db.Uuid
  product          Product        @relation(fields: [productId], references: [id])
  description      String         @db.VarChar(240)
  /// Cantidad **en la unidad de venta**: lo que el cliente pidió y lo que consume el
  /// pendiente del pedido.
  qty              Decimal        @db.Decimal(16, 3)
  unit             String         @db.VarChar(20)
  /// Cantidad **en la unidad del ítem de kardex**, que no siempre es la de venta: una
  /// cobertura se vende por pieza y sale de los kilos de una bobina (D-066). Es lo que
  /// mueve el kardex y lo que se descuenta de la reserva, y guardarla es lo que hace que
  /// la reversa devuelva exactamente lo mismo que sacó.
  reserveQty       Decimal        @map("reserve_qty") @db.Decimal(16, 3)
  /// Peso bruto declarado en la guía. Coincide con `reserveQty` cuando la reserva ya está
  /// en kilos, y es un dato de transporte —editable— cuando no.
  weightKg         Decimal        @map("weight_kg") @db.Decimal(16, 3)

  /// El par del kardex del que salió el material: el mismo que usan `inventory_balances`
  /// y `reservations` (D-066).
  itemType   InventoryItemType @map("item_type")
  itemId     String            @map("item_id") @db.Uuid
  /// Movimiento `OUT` que generó esta línea. Null solo en líneas de negocio sin
  /// inventario (`NOOP`, §2.2), donde `InventoryService.record` devuelve null a propósito.
  movementId BigInt?           @map("movement_id")

  @@unique([dispatchId, lineNumber])
  @@index([dispatchId])
  @@index([salesOrderItemId])
  @@map("dispatch_items")
}

/// Cobro de un comprobante (D-075). Espejo exacto de `supplier_payments`: el saldo se
/// recalcula y **nunca se almacena**, y revertir no borra la fila —la marca
/// `reversedAt`/`reversedById`— igual que la reversa de pago a proveedor de D-061.
///
/// Va contra el **comprobante**, no contra el pedido: es lo que hace que el saldo cierre
/// con facturación parcial o con notas de crédito de por medio.
model CustomerPayment {
  id         String         @id @default(uuid()) @db.Uuid
  documentId String         @map("document_id") @db.Uuid
  document   FiscalDocument @relation(fields: [documentId], references: [id])
  date       DateTime       @db.Date
  /// En soles, siempre (D-064). No hay moneda ni tipo de cambio en ventas.
  amountPen  Decimal        @map("amount_pen") @db.Decimal(18, 4)
  method     PaymentMethod
  reference  String?        @db.VarChar(120)

  createdById  String    @map("created_by_id") @db.Uuid
  reversedById String?   @map("reversed_by_id") @db.Uuid
  reversedAt   DateTime? @map("reversed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Venta de mostrador que registró este cobro (Fase 7b, D-100). Null en el resto.
  posSale PosSale?

  @@index([documentId])
  @@map("customer_payments")
}

// ---------------------------------------------------------------------------
// Fase 6 — coberturas metálicas y maestro de colores (RF-30..RF-33, RF-54; D-082..D-091)
// ---------------------------------------------------------------------------

/// Maestro de colores (RF-54, D-085).
///
/// Existe como tabla y no como texto libre en el producto por dos motivos que se refuerzan:
/// el filtro de bobina de la OP compara **ids**, no cadenas que alguien tipeó con un acento
/// distinto; y el `hexColor` deja mostrar la muestra real en el selector, que es como se
/// elige un rollo en planta. Baja lógica, nunca `DELETE`: un color desactivado sigue
/// explicando los productos y las bobinas que ya lo llevan.
model Color {
  id        String   @id @default(uuid()) @db.Uuid
  /// Código corto para el SKU y para las planillas de importación (`ROJ`, `AZU`).
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(80)
  /// `#RRGGBB`. Solo presentación: ninguna regla de negocio lo lee.
  hexColor  String   @map("hex_color") @db.VarChar(7)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products      Product[]
  coils         Coil[]
  purchaseItems PurchaseItem[]

  @@map("colors")
}

/// Plan de corte de una OP de coberturas (D-084): los subítems `{cantidad, largo}` que se
/// copian del pedido al crearla y que planta **puede editar** antes y durante la corrida.
///
/// Es una intención, no un hecho: lo que mueve kardex son los largos reportados
/// (`production_report_pieces`). Existe para que el operario no tenga que retipear la lista
/// del pedido y para poder comparar lo planificado con lo que salió.
model ProductionOrderItem {
  id                String          @id @default(uuid()) @db.Uuid
  productionOrderId String          @map("production_order_id") @db.Uuid
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lineNumber        Int             @map("line_number")
  /// Largo de la plancha en mm, misma escala que el resto de las medidas (D-003).
  lengthMm          Decimal         @map("length_mm") @db.Decimal(8, 2)
  qty               Int
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([productionOrderId, lineNumber])
  @@index([productionOrderId])
  @@map("production_order_items")
}

/// Los largos que de verdad salieron en un reporte de coberturas (D-083).
///
/// El kardex del producto a medida se lleva en metros, así que estas filas son la única
/// memoria de **cómo** se repartieron esos metros en planchas. La reversa de un reporte no
/// las borra: la fila del reporte queda `REVERTED` y estas se van con ella, igual que el
/// resto del proyecto trata lo append-only.
model ProductionReportPiece {
  id         String           @id @default(uuid()) @db.Uuid
  reportId   String           @map("report_id") @db.Uuid
  report     ProductionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lineNumber Int              @map("line_number")
  lengthMm   Decimal          @map("length_mm") @db.Decimal(8, 2)
  qty        Int

  @@unique([reportId, lineNumber])
  @@index([reportId])
  @@map("production_report_pieces")
}

/// Subítems de largo de una línea de cotización compuesta (D-083).
///
/// `quotation_items.qty` es la suma `Σ cantidad × largo` en metros y su `unit` es `MTR`:
/// estas filas son el desglose que el vendedor tipeó y que después viaja al pedido, a la OP
/// y a la descripción del comprobante.
model QuotationItemPiece {
  id              String        @id @default(uuid()) @db.Uuid
  quotationItemId String        @map("quotation_item_id") @db.Uuid
  quotationItem   QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  lineNumber      Int           @map("line_number")
  lengthMm        Decimal       @map("length_mm") @db.Decimal(8, 2)
  qty             Int

  @@unique([quotationItemId, lineNumber])
  @@index([quotationItemId])
  @@map("quotation_item_pieces")
}

/// Copia congelada de los subítems de largo en el pedido (D-083). Como el resto de la línea,
/// no se recalcula nunca contra la cotización después de confirmar.
model SalesOrderItemPiece {
  id               String         @id @default(uuid()) @db.Uuid
  salesOrderItemId String         @map("sales_order_item_id") @db.Uuid
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  lineNumber       Int            @map("line_number")
  lengthMm         Decimal        @map("length_mm") @db.Decimal(8, 2)
  qty              Int

  @@unique([salesOrderItemId, lineNumber])
  @@index([salesOrderItemId])
  @@map("sales_order_item_pieces")
}

// ---------------------------------------------------------------------------
// Fase 7b — punto de venta de mostrador (RF-60; D-098..D-104)
// ---------------------------------------------------------------------------

/// Estado de un turno de caja (D-101). Un usuario tiene como mucho un turno `OPEN`.
enum CashSessionStatus {
  OPEN
  CLOSED
}

/// Estado de una venta de mostrador (D-100). `VOIDED` es el resultado de la cadena de
/// reversas encadenadas; la fila nunca se borra, igual que el resto del proyecto.
enum PosSaleStatus {
  ACTIVE
  /// La cadena de reversas empezó y todavía no terminó (D-100). No puede ser atómica —el
  /// paso del comprobante habla con el PSE— así que la venta se **reclama** en este estado
  /// bajo el lock de su turno antes del primer paso: desde ahí deja de contar para el
  /// arqueo, un cierre de caja concurrente no la puede congelar como vigente y una segunda
  /// anulación no puede emitir una nota de crédito duplicada.
  VOIDING
  VOIDED
}

/// Turno de caja del punto de venta (D-101).
///
/// Existe porque **nada más en el sistema sabe a qué turno pertenece un cobro**: el
/// `customer_payments` de D-075 registra cuánto y con qué medio, no en qué caja entró. El
/// arqueo del cierre compara el efectivo esperado —apertura más las ventas en efectivo del
/// turno— contra lo contado, y guarda la diferencia con su motivo: es un hecho del turno,
/// no algo que se pueda recalcular después de que alguien cuente los billetes.
///
/// Los medios distintos de efectivo **no entran al arqueo** y sí al resumen: una venta con
/// tarjeta o Yape no pone billetes en el cajón, así que sumarla al esperado haría que toda
/// caja con tarjetas cerrara con faltante.
model CashSession {
  id     String            @id @default(uuid()) @db.Uuid
  seq    Int               @unique @default(autoincrement())
  status CashSessionStatus @default(OPEN)

  /// Dueño del turno. Un usuario abre y cierra su propia caja (D-101).
  userId String @map("user_id") @db.Uuid
  user   User   @relation("CashSessionUser", fields: [userId], references: [id])

  /// Copia de `userId` **mientras el turno está abierto**, `null` en cuanto se cierra.
  ///
  /// Existe solo para que el índice único de abajo diga "un turno abierto por usuario"
  /// en la base: Postgres no cuenta los nulos en un índice único, así que los turnos
  /// cerrados no se estorban entre sí. Sin esto la regla viviría únicamente en el
  /// servicio, y dos aperturas simultáneas del mismo cajero —dos pestañas, un doble
  /// toque— dejarían la caja partida en dos turnos que nadie sabría cuadrar.
  /// Un `CHECK` en la migración obliga a que valga `user_id` si y solo si está `OPEN`.
  openUserId String? @unique @map("open_user_id") @db.Uuid

  /// Monto con el que arranca el cajón. En soles, siempre (D-064).
  openingAmountPen Decimal  @map("opening_amount_pen") @db.Decimal(18, 4)
  openedAt         DateTime @default(now()) @map("opened_at") @db.Timestamptz(3)
  openingNotes     String?  @map("opening_notes") @db.VarChar(500)

  /// Arqueo del cierre. Los cuatro van juntos o van todos en null: un turno abierto no
  /// tiene arqueo, y uno cerrado siempre lo tiene (`CHECK` en la migración).
  ///
  /// `expectedCashPen` se **congela** al cerrar en vez de recalcularse: una reversa
  /// posterior de una venta cambiaría el esperado de un turno ya arqueado y el papel
  /// firmado por el cajero dejaría de coincidir con la pantalla.
  expectedCashPen Decimal?  @map("expected_cash_pen") @db.Decimal(18, 4)
  countedCashPen  Decimal?  @map("counted_cash_pen") @db.Decimal(18, 4)
  differencePen   Decimal?  @map("difference_pen") @db.Decimal(18, 4)
  /// Motivo de la diferencia. Obligatorio cuando `differencePen != 0` (D-101).
  closingNotes    String?   @map("closing_notes") @db.VarChar(500)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(3)
  closedById      String?   @map("closed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sales PosSale[]

  @@index([userId, status])
  @@index([status, openedAt])
  @@map("cash_sessions")
}

/// Una venta de mostrador (D-099, D-100).
///
/// **No duplica nada de lo que ya existe**: el pedido, el despacho, el comprobante y el
/// cobro son las filas de siempre, creadas por los servicios de siempre. Esta fila guarda
/// lo único que no se puede derivar de ellas —que los cuatro nacieron juntos en el
/// mostrador, en este turno de caja— y es lo que permite anular la venta como una cadena
/// de reversas identificable en vez de cuatro operaciones sueltas.
model PosSale {
  id     String        @id @default(uuid()) @db.Uuid
  seq    Int           @unique @default(autoincrement())
  status PosSaleStatus @default(ACTIVE)

  cashSessionId String      @map("cash_session_id") @db.Uuid
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])

  /// Los cuatro documentos de la venta. Únicos: un pedido de mostrador no se vuelve a
  /// vender, y sin la unicidad dos filas de POS podrían reclamar la misma cadena.
  salesOrderId      String          @unique @map("sales_order_id") @db.Uuid
  salesOrder        SalesOrder      @relation(fields: [salesOrderId], references: [id])
  dispatchId        String          @unique @map("dispatch_id") @db.Uuid
  dispatch          Dispatch        @relation(fields: [dispatchId], references: [id])
  fiscalDocumentId  String          @unique @map("fiscal_document_id") @db.Uuid
  fiscalDocument    FiscalDocument  @relation(fields: [fiscalDocumentId], references: [id])
  /// Cobro de la venta. Se conserva aunque la reversa lo marque `reversedAt`.
  customerPaymentId String          @unique @map("customer_payment_id") @db.Uuid
  customerPayment   CustomerPayment @relation(fields: [customerPaymentId], references: [id])

  /// Medio de pago y total, copiados del cobro para poder cuadrar la caja sin recorrer
  /// cuatro tablas por venta. El cobro sigue siendo la fuente de verdad.
  method   PaymentMethod
  totalPen Decimal       @map("total_pen") @db.Decimal(18, 4)

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedById  String?   @map("voided_by_id") @db.Uuid
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason  String?   @map("void_reason") @db.VarChar(500)

  @@index([cashSessionId, status])
  @@map("pos_sales")
}
